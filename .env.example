# Base de donnees Postgres (ex. Neon, gratuit : https://neon.tech)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Acces back-office admin (un seul compte admin, pas de comptes clients)
ADMIN_EMAIL="admin@exemple.com"
# Genere avec: node -e "console.log(require('bcryptjs').hashSync('ton-mot-de-passe', 10))"
# IMPORTANT (local uniquement) : Next.js interprete les "$" d'un .env local
# comme des references de variables ($2b, $10, ...) et les vide silencieusement.
# Il faut donc echapper chaque "$" du hash bcrypt en "\$" dans ce fichier local.
# Sur Vercel (ou tout hebergeur qui injecte les variables directement, sans
# parsing dotenv), ne PAS echapper : coller le hash tel quel, sans backslash.
ADMIN_PASSWORD_HASH=""
# Chaine aleatoire longue, sert a signer le cookie de session admin
ADMIN_SESSION_SECRET="change-moi-en-production"

# PayDunya (Senegal) - compte marchand requis, couvre Wave, Orange Money,
# Free Money et carte bancaire en une seule integration.
# Cles sur https://paydunya.com > Compte > Cles API
PAYDUNYA_MASTER_KEY=""
PAYDUNYA_PRIVATE_KEY=""
PAYDUNYA_TOKEN=""
# "test" (sandbox) ou "live" (production)
PAYDUNYA_MODE="test"

# URL publique du site (utilisee pour les redirections de paiement)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
