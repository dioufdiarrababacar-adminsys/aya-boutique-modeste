generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Univers {
  FEMMES
  HOMMES
  ENFANTS
}

enum PaymentMethod {
  WAVE
  ORANGE_MONEY
  FREE_MONEY
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  NOUVELLE
  EN_PREPARATION
  EXPEDIEE
  LIVREE
  ANNULEE
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  univers   Univers
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String
  priceCfa    Int
  univers     Univers
  category    Category    @relation(fields: [categoryId], references: [id])
  categoryId  String
  images      String
  sizes       String
  colors      String
  stock       Int         @default(0)
  isNew       Boolean     @default(false)
  isActive    Boolean     @default(true)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Order {
  id              String        @id @default(cuid())
  reference       String        @unique
  customerName    String
  customerPhone   String
  customerEmail   String?
  deliveryAddress String
  deliveryCity    String
  items           OrderItem[]
  subtotalCfa     Int
  deliveryFeeCfa  Int           @default(0)
  totalCfa        Int
  paymentMethod   PaymentMethod?
  paymentStatus   PaymentStatus @default(PENDING)
  paymentRef      String?
  status          OrderStatus   @default(NOUVELLE)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model OrderItem {
  id         String   @id @default(cuid())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  productName String
  size       String
  color      String
  unitPriceCfa Int
  quantity   Int
  createdAt  DateTime @default(now())
}
